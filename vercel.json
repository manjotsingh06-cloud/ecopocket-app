{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/images/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/images/$1"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "frontend",
        "path": "/favicon.svg"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}