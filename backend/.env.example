# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — create a free cluster at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecopocket

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Cloudinary — https://cloudinary.com (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer) — e.g. Gmail app password or SMTP provider like SendGrid/Mailgun
# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="EcoPocket <yourgmail@gmail.com>"

# Optional: real AI provider key to upgrade EcoBot from rule-based to LLM-generated answers
# (see backend/controllers/chatController.js for the single place this would be wired in)
AI_API_KEY=
